# ---------------------------------------------------------------------------
# Copy this file to .env (root) and to apps/api/.env, then fill in real values
# for anything beyond local development.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://hussain:hussain_dev_password@localhost:5432/hussain_perfume?schema=public"

# API
API_PORT=4000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

# Redis (sessions/caching, future ready)
REDIS_URL=redis://localhost:6379

# Cloudinary (product images) — placeholders until real account is connected
CLOUDINARY_CLOUD_NAME=changeme
CLOUDINARY_API_KEY=changeme
CLOUDINARY_API_SECRET=changeme

# Email (Resend) — placeholder until real account is connected
RESEND_API_KEY=changeme
EMAIL_FROM="Hussain Perfumes <no-reply@hussainperfumes.com>"

# Payments — placeholders, abstraction layer added when checkout is built
STRIPE_SECRET_KEY=changeme
STRIPE_WEBHOOK_SECRET=changeme
PAYPAL_CLIENT_ID=changeme
PAYPAL_CLIENT_SECRET=changeme

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
